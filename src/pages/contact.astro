---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contact | YOUR BUSINESS NAME" description="Contact YOUR BUSINESS NAME to talk through your next project, challenge, or opportunity.">
	<section class="border-b border-[var(--line)] bg-[#dfeee9]"><div class="container py-20 md:py-28"><p class="eyebrow">Contact</p><h1 class="display mt-5 max-w-3xl text-5xl leading-none sm:text-7xl">Tell us what is on your mind.</h1><p class="mt-7 max-w-xl text-lg leading-8 text-[var(--muted)]">A few details are enough to get the conversation started. No polished brief required.</p></div></section>
	<section class="container grid gap-14 py-16 md:grid-cols-[0.75fr_1.25fr] md:py-24"><div><p class="eyebrow">Other ways to reach us</p><div class="mt-7 space-y-6"><div><p class="font-bold">Email</p><a class="mt-1 block text-[var(--teal)]" href="mailto:hello@example.com">hello@example.com</a></div><div><p class="font-bold">Phone</p><a class="mt-1 block text-[var(--teal)]" href="tel:+15551234567">(555) 123-4567</a></div><div><p class="font-bold">Hours</p><p class="mt-1 text-[var(--muted)]">Monday-Friday, 9am-5pm</p></div></div></div><form class="space-y-6" action="#" method="post"><div class="grid gap-6 sm:grid-cols-2"><label class="block"><span class="text-sm font-bold">Name</span><input class="mt-2 w-full rounded-lg border border-[var(--line)] bg-white px-4 py-3" type="text" name="name" autocomplete="name" required /></label><label class="block"><span class="text-sm font-bold">Email</span><input class="mt-2 w-full rounded-lg border border-[var(--line)] bg-white px-4 py-3" type="email" name="email" autocomplete="email" required /></label></div><label class="block"><span class="text-sm font-bold">What can we help with?</span><textarea class="mt-2 min-h-40 w-full resize-y rounded-lg border border-[var(--line)] bg-white px-4 py-3" name="message" required></textarea></label><button class="rounded-full bg-[var(--teal)] px-6 py-4 font-bold text-white hover:bg-[var(--teal-dark)]" type="submit">Send inquiry</button><p class="text-xs leading-5 text-[var(--muted)]">This form is a front-end placeholder. Connect it to your preferred form service before launch.</p></form></section>
</MainLayout>