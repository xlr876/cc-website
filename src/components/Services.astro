---
const services = [{ number: '01', title: 'Clarity', text: 'Turn a complicated situation into a focused plan with priorities you can act on.' }, { number: '02', title: 'Capability', text: 'Get experienced, hands-on support for the work that needs care and follow-through.' }, { number: '03', title: 'Continuity', text: 'Build steady systems and habits that keep creating value after we finish together.' }];
const base = import.meta.env.BASE_URL;
---

<section id="services" class="container py-20 md:py-28"><div class="max-w-2xl"><p class="eyebrow">How we help</p><h2 class="display mt-4 text-4xl leading-tight sm:text-5xl">Less noise. More progress.</h2><p class="mt-5 text-lg leading-8 text-[var(--muted)]">The right support should make things feel more possible, not more complicated.</p></div><div class="mt-12 grid gap-4 md:grid-cols-3">{services.map((service) => <article class="group border-t-2 border-[var(--teal)] bg-white p-7 transition-transform hover:-translate-y-1"><span class="text-sm font-bold text-[var(--coral)]">{service.number}</span><h3 class="display mt-14 text-3xl">{service.title}</h3><p class="mt-4 leading-7 text-[var(--muted)]">{service.text}</p><a class="mt-7 inline-flex font-bold text-[var(--teal)]" href={`${base}/services`}>Learn more <span class="ml-2" aria-hidden="true">-&gt;</span></a></article>)}</div></section>